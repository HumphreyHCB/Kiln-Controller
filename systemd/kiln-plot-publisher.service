[Unit]
Description=Regenerate 24h/7d kiln plots and commit them to GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=humphrey
WorkingDirectory=/home/humphrey/repos/Kiln-Controller
ExecStart=/usr/bin/python3 /home/humphrey/repos/Kiln-Controller/scripts/publish_kiln_plots.py
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
