[Unit]
Description=Kiln controller with bounded Bluetooth recovery
Requires=kiln-relay-master.service
After=kiln-relay-master.service bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
User=humphrey
WorkingDirectory=/home/humphrey/repos/Kiln-Controller
ExecStartPre=/usr/bin/python3 /home/humphrey/repos/Kiln-Controller/scripts/kiln_service_state.py start
ExecStart=/usr/bin/bash /home/humphrey/repos/Kiln-Controller/run_kiln_recovering.sh
ExecStopPost=/usr/bin/python3 /home/humphrey/repos/Kiln-Controller/scripts/kiln_service_state.py stop
Restart=no
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
